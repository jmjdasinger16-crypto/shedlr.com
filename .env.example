# ── Shedlr Cloudflare Worker Environment Variables ──
# Set these in your Cloudflare Worker settings (Workers → shedlr-api → Settings → Variables)

# Admin dashboard password (full access: businesses, orders, leads, analytics)
ADMIN_PASSWORD=

# Optional: restricted staff password (e.g. for a VA). Logging in with this password
# only grants access to the read-only Businesses list (name/type/address) and the
# ability to add new leads — nothing else. Leave unset to disable staff logins entirely.
STAFF_PASSWORD=

# Optional: retention manager password. Read-only access to every business account
# in ANY status (active, past due, canceled, suspended), including full contact info,
# order history, delivered leads, and account notes. Cannot add or edit leads, edit
# accounts, or run reports. Leave unset to disable retention logins entirely.
RETENTION_PASSWORD=

# Secret used to sign admin session tokens (any long random string)
ADMIN_SESSION_SECRET=

# Secret used to sign business portal session tokens (any long random string)
BUSINESS_SESSION_SECRET=

# Stripe (optional — for payment processing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENT_LINK=https://buy.stripe.com/aFa14ndWdduSg2WgaYak002

# ── D1 Database Schema ──
# Create the D1 database first:
#   wrangler d1 create shedlr-leads
# Then replace YOUR_D1_DATABASE_ID in worker/wrangler.jsonc with the returned ID
# Then run the schema:
#   wrangler d1 execute shedlr-leads --file=worker/schema.sql

# ── Email ──
# Cloudflare's send_email binding (wrangler.jsonc) can ONLY deliver to destination
# addresses verified in this account's Email Routing. That makes it fine for internal
# alerts but unable to email customers, so activation emails need a real provider.
#
# Recipient for internal alerts. Must be a verified Email Routing destination.
INTERNAL_ALERT_EMAIL=support@liferise.cc
#
# Transactional provider for CUSTOMER-facing activation emails (optional).
# Without this, customers still activate via the post-checkout welcome page and
# support gets an alert containing the activation link to send by hand.
#   npx wrangler secret put RESEND_API_KEY --config worker/wrangler.jsonc
RESEND_API_KEY=
# From address for activation emails; the domain must be verified with the provider.
ACTIVATION_EMAIL_FROM=Shedlr <support@shedlr.com>

# ── Stripe Payment Link post-payment redirect (REQUIRED for auto-activation) ──
# In the Stripe Dashboard open the payment link → After payment → Redirect to a page,
# and set the URL to exactly:
#   https://shedlr.com/portal/welcome.html?session_id={CHECKOUT_SESSION_ID}
# That page verifies the session with Stripe and hands the buyer their activation link,
# so signup no longer depends on an email arriving.
